{
  "name": "stonebystone",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PWA for surveying and transcribing cemeteries",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "e2e": "playwright test --reporter=dot",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,html}": "prettier --write"
  },
  "dependencies": {
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "maplibre-gl": "~6.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.12.0",
    "@lingui/conf": "^6.12.0",
    "@lingui/native-tools": "^0.2.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-lingui": "^0.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "workbox-window": "^7.4.1"
  }
}
