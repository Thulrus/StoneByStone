{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thulrus.github.io/StoneByStone/schema/v2/section.json",
  "title": "Section",
  "description": "A named part of a cemetery.",
  "allOf": [
    {
      "$ref": "common.json#/definitions/cemeteryRecord"
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "boundary": {
          "$ref": "common.json#/definitions/polygon"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["name"]
    }
  ]
}
